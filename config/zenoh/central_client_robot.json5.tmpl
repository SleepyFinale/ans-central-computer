////
//// Central PC: extra Zenoh client + ros2dds for one robot domain.
//// Connects to the local fleet router at 127.0.0.1:7447.
//// Placeholders: __ROBOT__, __DOMAIN__
////
//// Same asymmetric allowlist as the router template (subs-only for map/tf).
////
{
  mode: "client",
  connect: {
    endpoints: ["tcp/127.0.0.1:7447"],
  },
  scouting: {
    multicast: { enabled: false },
  },
  plugins: {
    ros2dds: {
      domain: __DOMAIN__,
      ros_localhost_only: true,
      nodename: "zenoh_bridge_central___ROBOT__",
      allow: {
        publishers: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        subscribers: [
          "/__ROBOT__/map",
          "/__ROBOT__/map_wire_z",
          "/__ROBOT__/tf",
          "/__ROBOT__/tf_static",
          "/__ROBOT__/nav2_collision_ahead",
          "/__ROBOT__/nav2_retrace_active",
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_servers: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_clients: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        action_servers: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
        action_clients: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
      },
      pub_max_frequencies: [
        "/__ROBOT__/map=1",
        "/__ROBOT__/map_wire_z=1",
        "/__ROBOT__/tf=10",
        "/__ROBOT__/tf_static=1",
      ],
    },
  },
}
